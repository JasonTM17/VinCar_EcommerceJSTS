{
  "name": "autonova",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "test:e2e": "node scripts/e2e-checkout.mjs && node scripts/e2e-presales.mjs && node scripts/e2e-rate-limit.mjs",
    "db:push": "pnpm --filter @autonova/api exec prisma db push",
    "db:seed": "pnpm --filter @autonova/api exec ts-node prisma/seed.ts"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "prettier": "3.9.4",
    "eslint": "10.8.0"
  }
}
